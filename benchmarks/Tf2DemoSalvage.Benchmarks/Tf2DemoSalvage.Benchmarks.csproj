<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see the note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>

    <!-- **Release is not optional for a benchmark and the harness refuses Debug anyway.** Stated
         so a run started from an IDE's default configuration fails loudly rather than reporting
         numbers from an unoptimised build. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>

    <!-- BenchmarkDotNet generates and compiles its own harness assemblies at run time, and those
         generated sources do not carry this repository's documentation comments. Warnings-as-errors
         over generated code would fail a run for something nobody wrote. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1515;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />

    <!-- Under evaluation, not adopted. See Directory.Packages.props. -->
    <PackageReference Include="NLayer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../managed/Tf2DemoSalvage.Core/Tf2DemoSalvage.Core.csproj" />
    <ProjectReference Include="../../managed/Tf2DemoSalvage.Content/Tf2DemoSalvage.Content.csproj" />
  </ItemGroup>

</Project>
