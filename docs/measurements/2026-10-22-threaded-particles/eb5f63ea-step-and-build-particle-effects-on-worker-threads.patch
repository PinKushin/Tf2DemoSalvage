diff --git a/managed/Tf2DemoSalvage.Scene/FrameWorkers.cs b/managed/Tf2DemoSalvage.Scene/FrameWorkers.cs
new file mode 100644
index 00000000..2cbf104d
--- /dev/null
+++ b/managed/Tf2DemoSalvage.Scene/FrameWorkers.cs
@@ -0,0 +1,69 @@
+using System;
+using System.Threading.Tasks;
+
+namespace Tf2DemoSalvage.Scene;
+
+/// <summary>
+/// How many threads the frame's independent parts run on — `cl_frame_workers` (finding 94).
+/// </summary>
+/// <remarks>
+/// **Independent work only, merged in the serial order.** A caller hands <see cref="For"/> a body that writes into its
+/// own slot and nothing shared; the caller then merges the slots in index order, so the output is byte-identical
+/// whatever the count and whatever order the slots finish in. `CParticleMgr::UpdateNewEffects` is the model:
+/// `ParallelProcess( …, ProcessPSystem )` over the frame's sim list, with every step that "can call into random entity
+/// code" kept serial before it (particlemgr.cpp:1841-1884).
+///
+/// **One is serial**, the body run in index order on the calling thread, which is the A/B switch a measurement needs.
+/// </remarks>
+public sealed class FrameWorkers
+{
+    /// <summary>The most this uses, whatever the machine: past it the frame's parts are too small to share out.</summary>
+    public const int MaximumCount = 8;
+
+    /// <summary>A worker count for a run that has not chosen one: about the physical cores, and at most <see cref="MaximumCount"/>.</summary>
+    public static int DefaultCount { get; } = Math.Clamp(Environment.ProcessorCount / 2, 1, MaximumCount);
+
+    private readonly Action<int, Action<int>>? _schedule;
+
+    /// <summary>Workers at <see cref="DefaultCount"/>.</summary>
+    public FrameWorkers()
+    {
+    }
+
+    /// <summary>Workers that hand every index to a schedule of the caller's — a test running them backwards.</summary>
+    /// <param name="schedule">Runs the body once for each index below the count, in any order.</param>
+    public FrameWorkers(Action<int, Action<int>> schedule)
+    {
+        ArgumentNullException.ThrowIfNull(schedule);
+        _schedule = schedule;
+    }
+
+    /// <summary>How many threads at most; 1 or less is serial.</summary>
+    public int Count { get; set; } = DefaultCount;
+
+    /// <summary>Runs <paramref name="body"/> once for each index below <paramref name="count"/>.</summary>
+    /// <param name="count">How many indices.</param>
+    /// <param name="body">The work for one index; it must touch only that index's own state.</param>
+    public void For(int count, Action<int> body)
+    {
+        ArgumentNullException.ThrowIfNull(body);
+
+        if (_schedule is not null)
+        {
+            _schedule(count, body);
+            return;
+        }
+
+        if (Count <= 1 || count <= 1)
+        {
+            for (int index = 0; index < count; index++)
+            {
+                body(index);
+            }
+
+            return;
+        }
+
+        Parallel.For(0, count, new ParallelOptions { MaxDegreeOfParallelism = Count }, body);
+    }
+}
