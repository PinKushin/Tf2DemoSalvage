+    // ponytail: THROWAWAY B581 prototype state; deleted with the prototype.
+    private static readonly string? PrototypeMode = Environment.GetEnvironmentVariable("TF2VIEW_PROTO_RENDER_THREAD");
+    private static System.Threading.Tasks.Task? _pending;
+    private static long _workerTicks;
+    private static long _workerFrames;
+    private static long _joinTicks;
+
+    private static void TimedJoin()
+    {
+        long at = Stopwatch.GetTimestamp();
+        JoinPrototype();
+        System.Threading.Interlocked.Add(ref _joinTicks, Stopwatch.GetTimestamp() - at);
+    }
+
+    /// <summary>Prototype: waits for the previous frame's draw.</summary>
+    public static void JoinPrototype()
+    {
+        System.Threading.Tasks.Task? pending = _pending;
+        _pending = null;
+        pending?.GetAwaiter().GetResult();
+    }
+
+    /// <summary>Prototype: the worker's mean draw and the game thread's total join wait, in ms.</summary>
+    /// <returns>A report line, or null when the prototype is off.</returns>
+    public static string? PrototypeReport()
+    {
+        long frames = System.Threading.Interlocked.Read(ref _workerFrames);
+        return PrototypeMode is null || frames == 0
+            ? null
+            : string.Create(
+                System.Globalization.CultureInfo.InvariantCulture,
+                $"prototype {PrototypeMode}: {frames} frames, worker draw {_workerTicks * 1000.0 / Stopwatch.Frequency / frames:0.00} ms, join wait {_joinTicks * 1000.0 / Stopwatch.Frequency / frames:0.00} ms");
+    }
+
