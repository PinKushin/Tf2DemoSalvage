{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-valves-way.ps1\"",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "Valve's way"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hooks.ps1\" tf2-parity-cited.ps1 tf2-measurement-gate.ps1 tf2-merge-closes-its-bug.ps1",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "checking parity citations and measurement records"
          }
        ]
      },
      {
        "matcher": "mcp__tf2__console",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-measurement-gate.ps1\"",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "checking a measurement has its record"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hooks.ps1\" tf2-measurement-cited.ps1 tf2-thin-view.ps1",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "checking cited figures and the thin view"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hooks.ps1\" tf2-verify-build-output.ps1 tf2-flag-unread.ps1",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "checking the build and engine flags"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-measurement-cited.ps1\"",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "checking doc figures cite an observation"
          }
        ]
      }
    ]
  }
}
