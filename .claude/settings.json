{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/valves-way.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Valve's way"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/parity-cited.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking parity commits cite the engine"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-build-output.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking the build actually succeeded"
          }
        ]
      }
    ]
  }
}
