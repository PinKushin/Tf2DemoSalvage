{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-valves-way.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "Valve's way"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-parity-cited.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking parity commits cite the engine"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__tf2__console",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-measurement-gate.ps1\"",
            "shell": "powershell",
            "timeout": 20,
            "statusMessage": "checking a measurement has its record"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-measurement-cited.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking release-note figures cite an observation"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-thin-view.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking the view's domain reach only shrinks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-verify-build-output.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking the build actually succeeded"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-flag-unread.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking engine flags were looked up"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tf2-measurement-cited.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "statusMessage": "checking doc figures cite an observation"
          }
        ]
      }
    ]
  }
}
