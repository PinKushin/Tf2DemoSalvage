<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 1 decode engine (D2): container parsing, bit/varint primitives,
    SendTable-driven entity decode. Pure C# - no P/Invoke, no native dependency.
    Shared properties (nullability, analyzers) live in Directory.Build.props;
    TargetFramework must stay here - see the note in that file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Boundary rules that are impractical to exercise through the public API (e.g. the
         bit-addressable length limit, which would need a quarter-gigabyte buffer) are internal
         and tested directly. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Core.Tests" />

    <!-- `SyntheticDemo` and its writers, which lived in Core.Tests and use the same internals (D214). -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.TestSupport" />

    <!-- The viewer consumes these scene types, so its tests have to be able to BUILD one.
         `ScenePropTrack.AttachedTo` is written only by the timeline and so has an internal setter,
         which left the rule about bone-merged models (WornModels) untestable from the viewer's own
         suite - the gap that let B119 ship. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Viewer3D.Tests" />

    <!-- Where `WornModelsTests` lives since B184 moved the drawn-scene tests off the Windows TFM.
         Same reason as the entry above: `ScenePropTrack.AttachedTo` has an internal setter, so the
         bone-merge rule cannot be set up through the public API. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Rendering.Tests" />

    <!-- `TimelineMoments` lives in the scene and is the one adapter that writes back INTO a
         timeline - `OnNewModel`, which teaches a track which pose parameters wrap (B269). Testing
         that hop needs a timeline built from tracks, and `DemoTimeline.ForTracks` is internal
         because assembling one by hand is a test affordance rather than an API. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Scene.Tests" />

    <!-- A window's tracks are TRIMMED (D217 step 3), and `ScenePropTrack.TrimBefore` is internal: the projectile replay
         in `FrameParticles` read a dropped first keyframe and threw, which only a trimmed track can show. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Presentation.Tests" />

    <!-- The `timeline-resume` probe runs `DemoTimeline.BuildThroughSnapshot`, the snapshot-and-resume harness, on real
         demos: the synthetic test proves the mechanism, and only a real match has every feed and track at once (D217). -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Probe" />

    <!-- `DemoPlayer.CommandsRead`, an instrument rather than an API: `CorpusDemoPlayerRewindTests` counts a real demo's
         rewind re-reads with it (batch-33 review). -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Corpus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LZMA-SDK" />
    <!-- Crc32, for the Steam Voice trailer that tells a Steam payload from raw Speex (B441). -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build 3258's whole dem_datatables, for its SourceTV recordings that cut it at 2^16 bytes
         (B24, KnownSchema). -->
    <EmbeddedResource Include="Schema\Data\build3258-datatables.bin" LogicalName="Tf2DemoSalvage.Core.build3258-datatables.bin" />
    <!-- The shared activity list, ai_activity.h's enum in order (B437, SharedActivities). -->
    <EmbeddedResource Include="Scene\Data\shared-activities.txt" LogicalName="Tf2DemoSalvage.Core.shared-activities.txt" />
  </ItemGroup>

</Project>
