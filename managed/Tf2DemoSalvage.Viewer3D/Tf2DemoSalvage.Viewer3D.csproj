<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>tf2demoview</AssemblyName>
    <RootNamespace>Tf2DemoSalvage.Viewer3D</RootNamespace>

    <!-- Direct3D's C# surface is COM: every device call goes through a pointer, and the
         alternative to unsafe here is a copy per frame. This is the boundary the project's
         "unsafe before native" rule exists for. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinForms hosts the chrome. The viewport is a Panel whose handle the swap chain binds to,
         so Direct3D owns one rectangle and ordinary controls own everything around it. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The full logging package rather than Abstractions, because this is the composition root:
         it is the one project that BUILDS an ILoggerFactory and attaches providers. Everything
         else takes an ILogger it was handed (D83). -->
    <PackageReference Include="Microsoft.Extensions.Logging" />

    <PackageReference Include="Silk.NET.Direct3D11" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" />
    <PackageReference Include="Silk.NET.DXGI" />
    <PackageReference Include="Silk.NET.Maths" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell is internal (CA1515: an application's types are not an API), so the tests that
         assert its automation ids need to see inside. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Viewer3D.Tests" />
    <!-- So UI tests can name controls by the same constants the controls declare, rather than by
         literal strings that drift apart from them silently. -->
    <InternalsVisibleTo Include="Tf2DemoSalvage.Viewer3D.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />
    <ProjectReference Include="..\Tf2DemoSalvage.Content\Tf2DemoSalvage.Content.csproj" />
    <ProjectReference Include="..\Tf2DemoSalvage.Scene\Tf2DemoSalvage.Scene.csproj" />
    <ProjectReference Include="..\Tf2DemoSalvage.Render\Tf2DemoSalvage.Render.csproj" />
    <ProjectReference Include="..\Tf2DemoSalvage.Presentation\Tf2DemoSalvage.Presentation.csproj" />

    <!-- Glyph rasterisation (D84). This is the ONLY project that references Fonts, because it is
         the composition root: Fonts implements an interface declared in Content, and nothing
         between them needs to know GDI exists. -->
    <ProjectReference Include="..\Tf2DemoSalvage.Fonts\Tf2DemoSalvage.Fonts.csproj" />

    <!-- B168. This reference is the whole of what was missing: the audio project was finished,
         tested and unreachable — nothing outside it named its namespace, so 102 passing tests
         covered a subsystem that had never made a sound. -->
    <ProjectReference Include="..\Tf2DemoSalvage.Audio\Tf2DemoSalvage.Audio.csproj" />
  </ItemGroup>

</Project>
