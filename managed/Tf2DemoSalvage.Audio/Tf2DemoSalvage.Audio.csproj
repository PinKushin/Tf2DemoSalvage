<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Audio</RootNamespace>

    <!-- Marshalling PCM buffers across the P/Invoke boundary is the same case the viewer's D3D
         layer already documents (see D20): the alternative to unsafe/Span here is a copy on
         every decoded frame. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native library assets for libopus, MIT-licensed, prebuilt for every RID this project
         could run on. No managed wrapper - the P/Invoke surface here is this project's own,
         against the published opus.h, because a managed wrapper library would be one more
         thing between this project and the bits the engine actually produced. -->
    <PackageReference Include="libopus" />

    <!-- MP3, which is 82% of the sound files TF2 ships (13,140 of 15,958) because the voice
         archive is almost entirely MP3. Chosen over dr_mp3 via P/Invoke and over Media Foundation
         after benchmarking: NLayer decodes a voice line in 0.4 ms, which is far inside the 100 ms
         snd_mixahead budget, and it is managed so it needs no native build step per architecture.
         See docs/findings/31-game-audio.md. -->
    <PackageReference Include="NLayer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tf2DemoSalvage.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />

    <!-- For KeyValuesReader, which soundscripts are written in. Audio depends on Content and
         nothing depends on Audio, so this adds no cycle. The direction is the right way round:
         a soundscript is a game file, and reading game files is Content's job - but deciding
         what a sound IS belongs here, with everything else about sound. -->
    <ProjectReference Include="..\Tf2DemoSalvage.Content\Tf2DemoSalvage.Content.csproj" />
  </ItemGroup>

  <!-- celt.dll and speex.dll are not committed (tools/native-audio/README.md) - built once by
       tools/native-audio/build.ps1 from upstream Xiph source and copied flat into the output
       directory here, the same place NativeLibraryResolver looks for them. Condition="Exists"
       means a build without them present simply omits the Content item rather than failing;
       CeltVoiceDecoder/SpeexVoiceDecoder throw a message pointing at build.ps1 if actually used
       without it having been run. -->
  <ItemGroup>
    <Content Include="..\..\tools\native-audio\celt.dll" Condition="Exists('..\..\tools\native-audio\celt.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>celt.dll</Link>
    </Content>
    <Content Include="..\..\tools\native-audio\speex.dll" Condition="Exists('..\..\tools\native-audio\speex.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>speex.dll</Link>
    </Content>
  </ItemGroup>

  <!-- The same two libraries under their ELF names, built by tools/native-audio/build.sh. They are
       separate items rather than a platform condition on the ones above because BOTH may exist in a
       tree that has been built on both platforms, and each should be copied wherever it is found -
       the resolver picks by the running platform's naming convention, not by what is present. -->
  <ItemGroup>
    <Content Include="..\..\tools\native-audio\libcelt.so" Condition="Exists('..\..\tools\native-audio\libcelt.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libcelt.so</Link>
    </Content>
    <Content Include="..\..\tools\native-audio\libspeex.so" Condition="Exists('..\..\tools\native-audio\libspeex.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libspeex.so</Link>
    </Content>
  </ItemGroup>

</Project>
