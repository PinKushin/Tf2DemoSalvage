<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tf2DemoSalvage.Cli</RootNamespace>
    <AssemblyName>tf2demosalvage</AssemblyName>
    <!-- CA1515: this exe's types are referenced by the test project. Same reasoning as the
         fuzz project - see its .csproj. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tf2DemoSalvage.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Logging lives here and not in Core, deliberately. Core reports what happened by RETURNING
      it - NetMessageReadResult carries where a walk stopped and why - so a caller cannot ignore
      a decode failure without deciding to. A log line is a side effect that can be discarded
      silently, and it would also cost Core its dependency-free property, which the fuzz target
      relies on.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>

</Project>
