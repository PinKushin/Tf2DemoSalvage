<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Coverage-guided fuzz targets (D8). Built on every platform so the property
    definitions stay compiling and are reachable from the deterministic test suite,
    but only actually driven by libFuzzer on Linux/WSL - see docs/FUZZING.md.

    TargetFramework must stay here, not in Directory.Build.props - see note there.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tf2DemoSalvage.Fuzz</RootNamespace>
    <!-- CA1515 ("an app's types can be internal") and S3871 ("make this exception public")
         contradict each other in an executable that is also driven from a test project.
         CA1515's premise is the false one here: these types genuinely are referenced from
         outside the assembly, by the deterministic layer of D8. S3871 wins.
         Suppressed here rather than in .editorconfig because a `tests/<project>/**/*.cs`
         section does not match files sitting directly in the project directory. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />

    <!-- The voice targets drive real codec libraries through P/Invoke. That is the whole point of
         them: a fault in native code is memory corruption rather than an exception, so libFuzzer
         detects it by the process dying rather than by anything this assembly asserts. -->
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Audio\Tf2DemoSalvage.Audio.csproj" />
  </ItemGroup>

</Project>
