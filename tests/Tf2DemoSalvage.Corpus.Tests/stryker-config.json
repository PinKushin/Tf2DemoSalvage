{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/Schemas/stryker-config.schema.json",
  "stryker-config": {
    "project": "Tf2DemoSalvage.Core.csproj",
    "test-projects": [
      "Tf2DemoSalvage.Corpus.Tests.csproj"
    ],
    "additional-timeout": 10000,
    "reporters": [
      "progress",
      "html",
      "cleartext"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 0
    },
    "since": {
      "enabled": false,
      "target": "main",
      "ignore-changes-in": [
        "**/*.md",
        "**/docs/**",
        "**/tools/**"
      ]
    }
  }
}
