<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests that need a real demo. Split out from Tf2DemoSalvage.Core.Tests so mutation testing can
    run at two cadences: this project is the slow one (the corpus is 305 MB and its tests walk
    every file), while the synthetic project stays fast enough to mutate daily. See DECISIONS.md
    D25.

    Nothing here uses the synthetic fixtures - no BitWriter, no GameEventFixtures - which is why
    the split needed no shared test-support project. The seam was already there.
  -->
  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Corpus.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>

    <!-- NUnit discovers public fixtures; CA1515 wants an application's types internal.
         Inapplicable here rather than ignored. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1861: fixture arrays are passed inline by design. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Catches what NUnit otherwise accepts silently: a [Test] on a non-public method, an
         async void test, a [TestCase] whose arguments do not match the signature. -->
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- NUnit, the house standard. Package set mirrors PokemonBattleJournal's, which has
         run NUnit under Stryker nightly for months. Migrated off xunit.v3 2026-08-12. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <!-- CRC32, to identify the four trailing bytes of a steam-codec voice payload. Test-only:
         Core carries those bytes rather than validating them, so nothing ships this. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Content\Tf2DemoSalvage.Content.csproj" />
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Audio\Tf2DemoSalvage.Audio.csproj" />

    <!-- Scene, for the parts of it that are decisions about real demo data rather than about
         drawing: which player the camera follows, and cycling between them (B145). Plain net10.0,
         so this does not tie the corpus suite to Windows or keep it off the measurement boxes. -->
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Scene\Tf2DemoSalvage.Scene.csproj" />
  </ItemGroup>

</Project>
