<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Core.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- CA1861: fixture arrays are passed inline by design.
         CA5394: D8's deterministic layer needs a *seeded* generator so a failure names a
         reproducible case. A cryptographic RNG cannot be seeded - the "insecurity" CA5394
         warns about is exactly the property being relied on here. -->
    <NoWarn>$(NoWarn);CA1861;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- Property-based testing (D12). Apache-2.0. Generates inputs and shrinks failures to a
         minimal reproducing case, which removes hand-computed expected values - the source of
         most fixture bugs in this project so far. -->
    <PackageReference Include="CsCheck" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Core\Tf2DemoSalvage.Core.csproj" />
    <!-- D8's cheap layer drives the same property definitions the coverage-guided runner does,
         so the two cannot disagree about what a valid parse is. -->
    <ProjectReference Include="..\Tf2DemoSalvage.Fuzz\Tf2DemoSalvage.Fuzz.csproj" />
  </ItemGroup>

</Project>
