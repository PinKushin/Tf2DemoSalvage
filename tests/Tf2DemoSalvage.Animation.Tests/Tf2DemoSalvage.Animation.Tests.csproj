<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bone pipeline's suite, and its conformance denominator.

    Plain net10.0, like the project it covers, so it runs on the Linux measurement boxes and can be
    mutation tested there. That is not boilerplate here - it is the specific defect B184 records:
    Tf2DemoSalvage.Scene is net10.0 and has NO Stryker config, because 18 of its pose-path test
    files sit in the Windows-pinned Viewer3D.Tests. The densest behaviour in the renderer has never
    been mutated. This project exists partly so the replacement cannot repeat that.

    References SdkReference, which is what makes the denominator possible: the stage list for
    C_BaseAnimating::StandardBlendingRules is EXTRACTED from source-sdk-2013 rather than typed here,
    so it cannot go stale while looking complete. That is the SdkCoverageTests pattern, and B182
    exists because the pose path was the one subsystem without it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Animation.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>

    <!-- NUnit discovers public fixtures; CA1515 wants an application's types internal.
         Inapplicable here rather than ignored. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Animation\Tf2DemoSalvage.Animation.csproj" />
    <ProjectReference Include="..\Tf2DemoSalvage.SdkReference\Tf2DemoSalvage.SdkReference.csproj" />
  </ItemGroup>

  <!-- **The impact solver's expectations are written by Valve's binary, not here (B369).** The vphysics-impact probe calls
       FUN_18008e290 in the game's own vphysics.dll and writes what it left to Data/ivp-impact-solver.txt. The lanes' one
       definition is the probe's IvpImpactReplay, linked rather than copied, so the probe that asks and the suite that
       replays cannot read a lane differently; linked rather than referenced, because the probe is an executable that
       brings the renderer's projects with it. -->
  <ItemGroup>
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpImpactReplay.cs" Link="Oracle\IvpImpactReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpEntryReplay.cs" Link="Oracle\IvpEntryReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpComplementarityReplay.cs" Link="Oracle\IvpComplementarityReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpHeapCoreReplay.cs" Link="Oracle\IvpHeapCoreReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpHeapSolveReplay.cs" Link="Oracle\IvpHeapSolveReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpRotationReplay.cs" Link="Oracle\IvpRotationReplay.cs" />
    <Compile Include="..\..\tools\Tf2DemoSalvage.Probe\Oracle\IvpRestReplay.cs" Link="Oracle\IvpRestReplay.cs" />
    <None Update="Data\ivp-rest.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-rotation.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-heap-solve.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-heap-core.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-complementarity.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-impact-solver.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ivp-impact-entry.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
