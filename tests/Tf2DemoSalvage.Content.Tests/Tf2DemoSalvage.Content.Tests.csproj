<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Content.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>

    <!-- NUnit discovers public fixtures; CA1515 wants an application's types internal.
         Inapplicable here rather than ignored. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1861: fixture arrays are passed inline by design.
         CA5394: D8's deterministic layer needs a *seeded* generator so a failure names a
         reproducible case. A cryptographic RNG cannot be seeded - the "insecurity" CA5394
         warns about is exactly the property being relied on here. -->
    <NoWarn>$(NoWarn);CA1861;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <!-- Catches what NUnit otherwise accepts silently: a [Test] on a non-public method, an
         async void test, a [TestCase] whose arguments do not match the signature. -->
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- NUnit, the house standard. Package set mirrors PokemonBattleJournal's, which has
         run NUnit under Stryker nightly for months. Migrated off xunit.v3 2026-08-12. -->
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Shouldly" />
    <!-- Property-based testing (D12). Apache-2.0. Generates inputs and shrinks failures to a
         minimal reproducing case, which removes hand-computed expected values - the source of
         most fixture bugs in this project so far. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Content\Tf2DemoSalvage.Content.csproj" />
    <!-- Reads source-sdk-2013 so conformance tests check this project's constants against the
         engine's own declarations rather than against numbers typed a second time. -->
    <ProjectReference Include="..\Tf2DemoSalvage.SdkReference\Tf2DemoSalvage.SdkReference.csproj" />
    
         
  </ItemGroup>

</Project>
