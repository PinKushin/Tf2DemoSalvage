<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Cli.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are self-executing; they build as an exe. -->
    <OutputType>Exe</OutputType>
    <!-- CA1861: fixture arrays are passed inline by design. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- xunit.v3, not xunit. Version 2 is deprecated - NuGet reports it as "Legacy"
         with xunit.v3 as the replacement - and a deprecated package is a warning,
         which Zero Warnings forbids. Note that a plain `dotnet build` does NOT
         surface this; it takes `dotnet list package` with the deprecated switch. -->
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Cli\Tf2DemoSalvage.Cli.csproj" />
  </ItemGroup>

</Project>
