<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Cli.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>

    <!-- NUnit discovers public fixtures; CA1515 wants an application's types internal.
         Inapplicable here rather than ignored. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA1861: fixture arrays are passed inline by design. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <!-- Catches what NUnit otherwise accepts silently: a [Test] on a non-public method, an
         async void test, a [TestCase] whose arguments do not match the signature. -->
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- NUnit, the house standard. Package set mirrors PokemonBattleJournal's, which has
         run NUnit under Stryker nightly for months. Migrated off xunit.v3 2026-08-12. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Cli\Tf2DemoSalvage.Cli.csproj" />
  </ItemGroup>

</Project>
