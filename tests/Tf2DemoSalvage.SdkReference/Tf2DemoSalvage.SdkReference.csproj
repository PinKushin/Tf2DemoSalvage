<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.SdkReference</RootNamespace>

    <!-- Not a test project: it holds no fixtures, and every test project references it.
         Marking it one would make the runner discover an assembly with nothing to run,
         which reports as a suite whose total silently changed. -->
    <IsTestProject>false</IsTestProject>

    <!-- CA1515 wants an application's types internal; these exist to be used from other
         assemblies, which is the one case it does not apply to. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- **NUnit, for `Skip` alone.** This project deliberately does not assert: every accessor
         returns null when its subject is absent and the caller decides what that means, which is
         what lets a survey walk past a map it does not have. `Skip` is the other half of that
         contract - the one place that turns a null into a SKIP rather than a failure - and
         `Assert.Ignore` is NUnit's only way to record one.

         Not a new dependency for anybody: every project referencing this one is a test project and
         already has NUnit. IsTestProject stays false above - this holds no fixtures. -->
    <PackageReference Include="NUnit" />
  </ItemGroup>

</Project>
