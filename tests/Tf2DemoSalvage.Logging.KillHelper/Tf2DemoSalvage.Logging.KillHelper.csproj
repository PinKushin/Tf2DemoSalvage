<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A child process for measuring what a hard kill costs the file log (D230). Never shipped.

    It logs numbered lines, one a millisecond, through the real FileLogWriter (or the old
    synchronous AutoFlush writer, for the control) until the parent kills it. The parent compares
    the last number on disk against the number the clock says was due at the kill. Driver and
    results: docs/measurements/2026-10-24-d230-async-file-log.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Logging.KillHelper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Logging\Tf2DemoSalvage.Logging.csproj" />
  </ItemGroup>

</Project>
