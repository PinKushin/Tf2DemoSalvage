<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework must stay here, not in Directory.Build.props - see note there. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tf2DemoSalvage.Audio.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>

    <!-- NUnit discovers public fixtures; CA1515 wants an application's types internal.
         Inapplicable here rather than ignored. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
    <!-- CA5394: the deterministic fuzz layer needs a *seeded* generator so a failure names a
         reproducible case. A cryptographic RNG cannot be seeded - the "insecurity" CA5394 warns
         about is exactly the property being relied on here. Same justification, same wording, as
         Core.Tests and Content.Tests, which carry it for the same suites. -->
    <NoWarn>$(NoWarn);CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <!-- Catches what NUnit otherwise accepts silently: a [Test] on a non-public method, an async
         void test, a [TestCase] whose arguments do not match the signature. -->
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Tf2DemoSalvage.Audio\Tf2DemoSalvage.Audio.csproj" />

    <!-- The voice fuzz targets are defined in the fuzz project and driven from here, the same way
         Core.Tests drives the bit reader and container targets: one definition of the property,
         exercised both by the deterministic suite and by libFuzzer, so the cheap layer and the
         expensive layer cannot drift apart about what "correct" means. -->
    <ProjectReference Include="..\Tf2DemoSalvage.Fuzz\Tf2DemoSalvage.Fuzz.csproj" />
  </ItemGroup>

</Project>
