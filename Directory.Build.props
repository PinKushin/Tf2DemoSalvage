<Project>

  <!--
    TargetFramework is deliberately NOT set here - it is declared per-project.

    Stryker.NET's project analysis (Buildalyzer) fails outright with
    "Failed to analyze project builds" when the TFM comes from Directory.Build.props
    rather than the .csproj; its diagnostic log says only "No analyzer results to log",
    with no MSBuild error pointing at the cause. Bisected 2026-08-07. Every other
    property below is safe to centralize.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!-- D6 / global standards: explicit usings, non-null by default, zero warnings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Roslyn analyzer stack, enabled at build time rather than IDE-only (D6). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.19.0.132793">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
