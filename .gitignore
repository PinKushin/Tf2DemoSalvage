# Visual Studio / MSBuild
.vs/
bin/
obj/
x64/
x86/
Debug/
Release/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test / analysis output
TestResults/
StrykerOutput/
artifacts/

# C build artifacts
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
!tools/**/*.dll

# OS cruft
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp

# Self-recorded demos used for correctness ground truth (D5): kept local so the
# owner's screen name and SteamID never enter a public repo.
tools/corpus/local/

# Native audio codec binaries — built by tools/native-audio/build.ps1, not committed.
# See tools/native-audio/README.md.
tools/native-audio/*.dll

# Coverage reports from `--collect:"XPlat Code Coverage"`. CI writes them under coverage/ and
# uploads them as an artifact on failure; they are never committed.
coverage/

# BenchmarkDotNet's generated harness projects and reports.
BenchmarkDotNet.Artifacts/
*-ShortRun-*/

# **Default WinForms resource files, which MSBuild regenerates and nobody edits.** Three appeared
# untracked on 2026-08-26 — MainForm, OverlayWindow, TransportBar — byte-identical 5,817-byte empty
# templates. The project had built for weeks without them, so they are generated boilerplate rather
# than source. Ignored rather than committed: a designer file with no designer content is noise, and
# a `git add -A` during a large refactor is exactly when it slips in unnoticed.
#
# A resx that ever holds real resources should be force-added and this line narrowed.
managed/Tf2DemoSalvage.Viewer3D/*.resx
