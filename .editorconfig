root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.cs]
# --- Style: file-scoped namespaces, var only when the type is apparent ---
csharp_style_namespace_declarations = file_scoped:error
# No var, anywhere. The owner's preference, and enforced rather than suggested: the type
# belongs at the start of the line where the eye lands, not inferred from the right-hand
# side. Where that would name the type twice, target-typed `new()` drops the repetition -
# `List<byte> bytes = new();` rather than `var bytes = new List<byte>();`.
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = always:error
csharp_prefer_braces = true:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true

# --- Naming: interfaces IPrefixed, private fields _camelCase ---
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscored.severity = error
dotnet_naming_rule.private_fields_underscored.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscored.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Correctness rules escalated to error (D6: correctness surfaces at build time) ---
dotnet_diagnostic.CA2000.severity = error   # dispose objects before losing scope
dotnet_diagnostic.CA2100.severity = error   # SQL injection vector
dotnet_diagnostic.CA1062.severity = error   # validate public method arguments
dotnet_diagnostic.CA1806.severity = error   # do not ignore method results
dotnet_diagnostic.CA2201.severity = error   # do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = error   # instantiate argument exceptions correctly
dotnet_diagnostic.CS8600.severity = error   # null literal to non-nullable
dotnet_diagnostic.CS8602.severity = error   # dereference of a possibly-null reference
dotnet_diagnostic.CS8603.severity = error   # possible null reference return
dotnet_diagnostic.CS8618.severity = error   # non-nullable field uninitialized
dotnet_diagnostic.CS8933.severity = error   # using directive already global

# --- Quoting the engine is the point, not dead code ---
#
# S125 flags "commented out code", and in this repository it fires on TRUE POSITIVES that are
# exactly what the codebase is for: a comment carrying the line of Valve's source that a piece of
# code was ported from.
#
#     NDotL = NDotL * 0.5 + 0.5;              common_vs_fxc.h:826
#     baseColor * baseColor2 * g_DiffuseModulation   unlittwotexture_ps2x.fxc
#     pSkinref(skin * numskinref + material)
#
# Those citations are the single most valuable convention here — they are how "read the SDK first"
# survives into a session that has forgotten why. Because every firing is a true positive by the
# rule's own definition, per-site suppression would be permanent noise rather than an occasional
# escape hatch, and the pressure would be to reword citations until they stop looking like code,
# which destroys the thing being kept.
#
# Dead code is still guarded, by rules that measure it directly: unused members, unreachable code,
# and the standing ban on stubs. Turning this off costs a weak signal and keeps a strong one.
#
# The known trade: `rg` for a formula now matches comments as well as code. That is wanted here —
# finding where an equation is CITED is usually the question, not where it is evaluated.
dotnet_diagnostic.S125.severity = none      # "commented out code" — engine citations, deliberate

# --- Noise: documentation and localization rules off, this is not a public API surface yet ---
dotnet_diagnostic.CS1591.severity = none    # missing XML comment
dotnet_diagnostic.CA1303.severity = none    # do not pass literals as localized parameters
dotnet_diagnostic.CA1848.severity = none    # use LoggerMessage delegates

[tests/**/*.cs]
# Tests legitimately construct and discard, and use non-localized literals everywhere.
dotnet_diagnostic.CA1707.severity = none    # Method_Scenario_Expected naming has underscores
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA1861.severity = none    # constant arrays as arguments (fixtures)
