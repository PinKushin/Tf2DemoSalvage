root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.cs]
# --- Style: file-scoped namespaces, var only when the type is apparent ---
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_require_accessibility_modifiers = always:error
csharp_prefer_braces = true:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true

# --- Naming: interfaces IPrefixed, private fields _camelCase ---
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscored.severity = error
dotnet_naming_rule.private_fields_underscored.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscored.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Correctness rules escalated to error (D6: correctness surfaces at build time) ---
dotnet_diagnostic.CA2000.severity = error   # dispose objects before losing scope
dotnet_diagnostic.CA2100.severity = error   # SQL injection vector
dotnet_diagnostic.CA1062.severity = error   # validate public method arguments
dotnet_diagnostic.CA1806.severity = error   # do not ignore method results
dotnet_diagnostic.CA2201.severity = error   # do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = error   # instantiate argument exceptions correctly
dotnet_diagnostic.CS8600.severity = error   # null literal to non-nullable
dotnet_diagnostic.CS8602.severity = error   # dereference of a possibly-null reference
dotnet_diagnostic.CS8603.severity = error   # possible null reference return
dotnet_diagnostic.CS8618.severity = error   # non-nullable field uninitialized
dotnet_diagnostic.CS8933.severity = error   # using directive already global

# --- Noise: documentation and localization rules off, this is not a public API surface yet ---
dotnet_diagnostic.CS1591.severity = none    # missing XML comment
dotnet_diagnostic.CA1303.severity = none    # do not pass literals as localized parameters
dotnet_diagnostic.CA1848.severity = none    # use LoggerMessage delegates

[tests/**/*.cs]
# Tests legitimately construct and discard, and use non-localized literals everywhere.
dotnet_diagnostic.CA1707.severity = none    # Method_Scenario_Expected naming has underscores
dotnet_diagnostic.CA2000.severity = suggestion
dotnet_diagnostic.CA1861.severity = none    # constant arrays as arguments (fixtures)
